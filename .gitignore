# Receiver-specific experiments require local IQ and archived reports.
/tools/compare_amc20_receiver_windows.py
/tools/evaluate_amc20_unknown.py
/tools/report_dataset20.py
/tools/report_receiver_verification.py
/tools/verify_receiver_*.py
/tools/verify_amc20_service.py
/tools/validate_signal_recognition_011.py

