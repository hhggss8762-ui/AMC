dist/
/data/
/runs/
/delivery/
.env
.env.*
!.env.example

# Historical offline export tool stays local.
/tools/package_signal_recognition.py

# Weights stay local; published Docker images contain the inference checkpoint.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
/models/*
