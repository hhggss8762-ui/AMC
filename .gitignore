.pytest_cache/
*.egg-info/
*.py[cod]
build/
dist/
/data/
/runs/
/delivery/
.env
.env.*
!.env.example

# Historical offline export tool stays local.
/tools/package_signal_recognition.py

# Only the frozen inference checkpoint and its description are versioned.
/models/*
!/models/README.md
!/models/amc_baseline_v1.pt

